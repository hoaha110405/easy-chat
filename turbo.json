{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VITE_API_BASE_URL"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "env": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "FRONTEND_URL",
        "ZALO_APP_ID",
        "ZALO_APP_SECRET",
        "ZALO_REDIRECT_URI",
        "ZALO_OA_SECRET_KEY",
        "TOKEN_ENCRYPTION_KEY",
        "ADMIN_PASSWORD",
        "SESSION_SECRET",
        "VITE_API_BASE_URL",
        "API_PROXY_TARGET",
        "DEV_ALLOWED_HOSTS",
        "ZALO_PERSONAL_ENABLED",
        "ZALO_PERSONAL_SEND_MAX_ATTEMPTS",
        "ZALO_PERSONAL_SEND_INTERVAL_MS",
        "TIKTOK_BUSINESS_ENABLED",
        "TIKTOK_BUSINESS_APP_ID",
        "TIKTOK_BUSINESS_APP_SECRET",
        "TIKTOK_BUSINESS_AUTHORIZATION_URL",
        "TIKTOK_BUSINESS_REDIRECT_URI",
        "TIKTOK_SHOP_ENABLED",
        "TIKTOK_SHOP_APP_KEY",
        "TIKTOK_SHOP_APP_SECRET",
        "TIKTOK_SHOP_AUTHORIZATION_URL",
        "TIKTOK_SHOP_REDIRECT_URI",
        "FACEBOOK_APP_ID",
        "FACEBOOK_APP_SECRET",
        "FACEBOOK_GRAPH_API_VERSION",
        "FACEBOOK_VERIFY_TOKEN",
        "FACEBOOK_OAUTH_REDIRECT_URI",
        "FACEBOOK_PERSONAL_ENABLED",
        "TELEGRAM_PERSONAL_ENABLED",
        "TELEGRAM_API_ID",
        "TELEGRAM_API_HASH",
        "TELEGRAM_BOT_ENABLED",
        "TELEGRAM_BOT_WEBHOOK_BASE_URL",
        "TELEGRAM_TDLIB_BRIDGE_PATH",
        "TELEGRAM_TDJSON_LIBRARY",
        "TELEGRAM_DATA_DIR",
        "TELEGRAM_RPC_SOCKET",
        "WHATSAPP_ENABLED",
        "WHATSAPP_GRAPH_API_VERSION",
        "WHATSAPP_META_APP_ID",
        "WHATSAPP_META_APP_SECRET",
        "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
        "WHATSAPP_WEBHOOK_CALLBACK_URL",
        "WHATSAPP_EMBEDDED_SIGNUP_ENABLED",
        "WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID"
      ],
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "worker:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "FRONTEND_URL",
        "ZALO_APP_ID",
        "ZALO_APP_SECRET",
        "ZALO_REDIRECT_URI",
        "ZALO_OA_SECRET_KEY",
        "TOKEN_ENCRYPTION_KEY",
        "ADMIN_PASSWORD",
        "SESSION_SECRET",
        "VITE_API_BASE_URL",
        "API_PROXY_TARGET",
        "DEV_ALLOWED_HOSTS",
        "ZALO_PERSONAL_ENABLED",
        "ZALO_PERSONAL_SEND_MAX_ATTEMPTS",
        "ZALO_PERSONAL_SEND_INTERVAL_MS",
        "TIKTOK_BUSINESS_ENABLED",
        "TIKTOK_BUSINESS_APP_ID",
        "TIKTOK_BUSINESS_APP_SECRET",
        "TIKTOK_BUSINESS_AUTHORIZATION_URL",
        "TIKTOK_BUSINESS_REDIRECT_URI",
        "TIKTOK_SHOP_ENABLED",
        "TIKTOK_SHOP_APP_KEY",
        "TIKTOK_SHOP_APP_SECRET",
        "TIKTOK_SHOP_AUTHORIZATION_URL",
        "TIKTOK_SHOP_REDIRECT_URI",
        "FACEBOOK_APP_ID",
        "FACEBOOK_APP_SECRET",
        "FACEBOOK_GRAPH_API_VERSION",
        "FACEBOOK_VERIFY_TOKEN",
        "FACEBOOK_OAUTH_REDIRECT_URI",
        "FACEBOOK_PERSONAL_ENABLED",
        "TELEGRAM_PERSONAL_ENABLED",
        "TELEGRAM_API_ID",
        "TELEGRAM_API_HASH",
        "TELEGRAM_BOT_ENABLED",
        "TELEGRAM_BOT_WEBHOOK_BASE_URL",
        "TELEGRAM_TDLIB_BRIDGE_PATH",
        "TELEGRAM_TDJSON_LIBRARY",
        "TELEGRAM_DATA_DIR",
        "TELEGRAM_RPC_SOCKET",
        "WHATSAPP_ENABLED",
        "WHATSAPP_GRAPH_API_VERSION",
        "WHATSAPP_META_APP_ID",
        "WHATSAPP_META_APP_SECRET",
        "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
        "WHATSAPP_WEBHOOK_CALLBACK_URL",
        "WHATSAPP_EMBEDDED_SIGNUP_ENABLED",
        "WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID"
      ]
    }
  }
}
