{
  "name": "@zalo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.spec.ts'",
    "test:integration": "vitest run test/database.integration.spec.ts test/personal.integration.spec.ts test/facebook.integration.spec.ts test/tiktok.integration.spec.ts test/unread.integration.spec.ts test/telegram.integration.spec.ts test/whatsapp.integration.spec.ts test/media.integration.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker:dev": "nest start --entryFile worker --watch --path tsconfig.worker.json",
    "worker:start": "node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.0",
    "@zalo/shared": "workspace:*",
    "axios": "^1.13.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "json-bigint": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zca-js": "^2.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.15.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/json-bigint": "^1.0.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@zalo/tsconfig": "workspace:*",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
