# Reference backend configuration. pnpm env:init creates apps/api/.env securely.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalo_inbox?schema=public
FRONTEND_URL=http://localhost:5173

# Zalo Developer application ID and application secret (token header: secret_key).
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/zalo/callback
# Official Account secret for X-ZEvent-Signature. This is not the App Secret.
ZALO_OA_SECRET_KEY=

# 32 random bytes as 64 hex characters. Keep stable across restarts.
TOKEN_ENCRYPTION_KEY=
# At least 12 characters. Only entered by the administrator in the login page.
ADMIN_PASSWORD=
# At least 32 random characters. Signs opaque session cookies.
SESSION_SECRET=

# Zalo Personal (independent from OA); uses TOKEN_ENCRYPTION_KEY for sessions.
ZALO_PERSONAL_ENABLED=true
ZALO_PERSONAL_SEND_MAX_ATTEMPTS=3
ZALO_PERSONAL_SEND_INTERVAL_MS=1500

# Meta Facebook Page; credentials stay server-side, separate from Zalo.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/channels/facebook-page/oauth/callback
# Personal Messenger is deliberately unsupported until a verified adapter exists.
FACEBOOK_PERSONAL_ENABLED=false
