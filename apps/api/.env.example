# Reference backend configuration. pnpm env:init creates apps/api/.env securely.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalo_inbox?schema=public
FRONTEND_URL=http://localhost:5173

# Zalo Developer application ID and application secret (token header: secret_key).
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/zalo/callback
# Official Account secret for X-ZEvent-Signature. This is not the App Secret.
ZALO_OA_SECRET_KEY=

# 32 random bytes as 64 hex characters. Keep stable across restarts.
TOKEN_ENCRYPTION_KEY=
# At least 12 characters. Only entered by the administrator in the login page.
ADMIN_PASSWORD=
# At least 32 random characters. Signs opaque session cookies.
SESSION_SECRET=

# Zalo Personal (independent from OA); uses TOKEN_ENCRYPTION_KEY for sessions.
ZALO_PERSONAL_ENABLED=true
ZALO_PERSONAL_SEND_MAX_ATTEMPTS=3
ZALO_PERSONAL_SEND_INTERVAL_MS=1500

# Meta Facebook Page; credentials stay server-side, separate from Zalo.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/channels/facebook-page/oauth/callback
# Personal Messenger is deliberately unsupported until a verified adapter exists.
FACEBOOK_PERSONAL_ENABLED=false

# Official TikTok Business; copy the account-holder authorization URL from the app dashboard.
TIKTOK_BUSINESS_ENABLED=true
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
TIKTOK_BUSINESS_AUTHORIZATION_URL=
TIKTOK_BUSINESS_REDIRECT_URI=http://localhost:3000/api/channels/tiktok-business/oauth/callback
# TikTok Shop is separate and requires approved seller.customer_service access.
TIKTOK_SHOP_ENABLED=false
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_AUTHORIZATION_URL=
TIKTOK_SHOP_REDIRECT_URI=http://localhost:3000/api/channels/tiktok-shop/oauth/callback

# Official Telegram Bot API and TDLib; keep credentials server-side.
TELEGRAM_PERSONAL_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_WEBHOOK_BASE_URL=
TELEGRAM_TDLIB_BRIDGE_PATH=../../native/telegram/build/tdjson-bridge
TELEGRAM_TDJSON_LIBRARY=../../.local/tdlib/lib/libtdjson.so
TELEGRAM_DATA_DIR=../../.local/telegram
TELEGRAM_RPC_SOCKET=../../.local/telegram/worker.sock

# WhatsApp Business Cloud API (official Meta; per-account tokens in UI)
WHATSAPP_ENABLED=true
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_CALLBACK_URL=
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
